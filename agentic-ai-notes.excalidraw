   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "@function_tool\ndef get_order(order_id: str) -> dict:\n    \"\"\"Get one order's status + delivery date.\n    Use when the user mentions an order number.\"\"\"",
   "originalText": "@function_tool\ndef get_order(order_id: str) -> dict:\n    \"\"\"Get one order's status + delivery date.\n    Use when the user mentions an order number.\"\"\"",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "n03206361",
   "type": "text",
   "x": 680,
   "y": 2900,
   "width": 432.40000000000003,
   "height": 170.0,
   "angle": 0,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
