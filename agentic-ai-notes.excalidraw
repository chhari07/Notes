   "text": "my_graph/src/agent/\n├─ state.py  # class State(TypedDict)\n├─ nodes.py  # call_model(), call_tools()\n├─ tools.py  # @tool functions\n├─ graph.py  # StateGraph(State)\n│   # .add_node .add_edge\n│   # .add_conditional_edges\n│   # .compile(checkpointer)\n└─ langgraph.json # `langgraph dev`",
   "originalText": "my_graph/src/agent/\n├─ state.py  # class State(TypedDict)\n├─ nodes.py  # call_model(), call_tools()\n├─ tools.py  # @tool functions\n├─ graph.py  # StateGraph(State)\n│   # .add_node .add_edge\n│   # .add_conditional_edges\n│   # .compile(checkpointer)\n└─ langgraph.json # `langgraph dev`",
