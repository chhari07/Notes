   "isDeleted": false,
   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "prompt types inside agents\n- system prompt: role+goal+rules+format (XML)\n- tool text: WHEN to use + what inputs mean\n   (model only sees this text!)\n- ReAct: think -> tool -> read -> repeat\n- structured output: JSON via zod / Pydantic\n- routing: small 'triage' prompt picks agent\n- CrewAI: role, goal, backstory (YAML)",
   "originalText": "prompt types inside agents\n- system prompt: role+goal+rules+format (XML)\n- tool text: WHEN to use + what inputs mean\n   (model only sees this text!)\n- ReAct: think -> tool -> read -> repeat\n- structured output: JSON via zod / Pydantic\n- routing: small 'triage' prompt picks agent\n- CrewAI: role, goal, backstory (YAML)",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
