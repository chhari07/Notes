   "text": "my-ai-app/  (Next.js)\n├─ app/page.tsx           # chat UI useChat()\n├─ app/api/chat/route.ts  # agent.stream()\n├─ lib/agent.ts   # new ToolLoopAgent({ model,\n│                #  instructions, tools, stopWhen})\n├─ lib/models.ts  # switch model in 1 line\n├─ lib/tools/     # tool({ inputSchema, execute })\n└─ .env.local     # keys or AI_GATEWAY_API_KEY",
   "originalText": "my-ai-app/  (Next.js)\n├─ app/page.tsx           # chat UI useChat()\n├─ app/api/chat/route.ts  # agent.stream()\n├─ lib/agent.ts   # new ToolLoopAgent({ model,\n│                #  instructions, tools, stopWhen})\n├─ lib/models.ts  # switch model in 1 line\n├─ lib/tools/     # tool({ inputSchema, execute })\n└─ .env.local     # keys or AI_GATEWAY_API_KEY",
