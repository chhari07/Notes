  {
   "id": "n03181723",
   "type": "text",
   "x": 680,
   "y": 2520,
   "width": 394.0,
   "height": 211.25,
   "angle": 0,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00318",
   "roundness": null,
   "seed": 876072107,
   "version": 1,
   "versionNonce": 1094845895,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "SYSTEM_PROMPT = \"\"\"\n<role>You are the support agent for Stack.</role>\n<goal>Solve it in as few steps as possible.</goal>\n<tools>\n- Call get_order BEFORE any order answer.\n- Call search_docs when unsure.\n</tools>\n<rules>\n- Never invent order data.\n- Ask one short question if info is missing.\n</rules>\n<output>2-3 short lines + next step</output>\n\"\"\"",
   "originalText": "SYSTEM_PROMPT = \"\"\"\n<role>You are the support agent for Stack.</role>\n<goal>Solve it in as few steps as possible.</goal>\n<tools>\n- Call get_order BEFORE any order answer.\n- Call search_docs when unsure.\n</tools>\n<rules>\n- Never invent order data.\n- Ask one short question if info is missing.\n</rules>\n<output>2-3 short lines + next step</output>\n\"\"\"",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "n03191626",
   "type": "text",
   "x": 680,
   "y": 2800,
   "width": 394.0,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#ffe066",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
