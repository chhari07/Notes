   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "my-product/  (pnpm + Turborepo)\n├─ apps/web/        # Next.js UI + API\n│  ├─ app/chat/page.tsx  # useChat()\n│  ├─ app/api/chat/route.ts\n│  │    # login check -> runAgent()\n│  └─ lib/auth.ts   # Clerk\n├─ apps/worker/     # long jobs (queue)\n├─ packages/agents/ # ALL agent code\n│  ├─ src/index.ts  # runAgent()\n│  ├─ src/tools/ prompts/\n│  └─ evals/        # test Qs + scores\n├─ packages/db/     # Prisma / Drizzle\n└─ packages/types/  # zod for both",
   "originalText": "my-product/  (pnpm + Turborepo)\n├─ apps/web/        # Next.js UI + API\n│  ├─ app/chat/page.tsx  # useChat()\n│  ├─ app/api/chat/route.ts\n│  │    # login check -> runAgent()\n│  └─ lib/auth.ts   # Clerk\n├─ apps/worker/     # long jobs (queue)\n├─ packages/agents/ # ALL agent code\n│  ├─ src/index.ts  # runAgent()\n│  ├─ src/tools/ prompts/\n│  └─ evals/        # test Qs + scores\n├─ packages/db/     # Prisma / Drizzle\n└─ packages/types/  # zod for both",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
