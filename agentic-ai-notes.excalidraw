   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "my-claude-agent/\n├─ .claude/agents/   # sub-agents (.md)\n├─ .claude/skills/   # SKILL.md\n├─ CLAUDE.md         # rules it always reads\n├─ .mcp.json         # outside tools (MCP)\n├─ src/index.ts      # for await (msg of query())\n├─ src/agent.ts      # model, allowedTools,\n│                    #   systemPrompt, permissionMode\n├─ src/tools/        # tool() + createSdkMcpServer()\n└─ .env              # ANTHROPIC_API_KEY",
   "originalText": "my-claude-agent/\n├─ .claude/agents/   # sub-agents (.md)\n├─ .claude/skills/   # SKILL.md\n├─ CLAUDE.md         # rules it always reads\n├─ .mcp.json         # outside tools (MCP)\n├─ src/index.ts      # for await (msg of query())\n├─ src/agent.ts      # model, allowedTools,\n│                    #   systemPrompt, permissionMode\n├─ src/tools/        # tool() + createSdkMcpServer()\n└─ .env              # ANTHROPIC_API_KEY",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
