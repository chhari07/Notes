   "text": "my-openai-agent/\n├─ src/index.ts        # await run(triage, input)\n├─ src/agents/triage.ts # handoffs: [a, b]\n├─ src/agents/billing.ts# new Agent({name,\n│                      #  instructions, tools})\n├─ src/tools/getOrder.ts# tool({ parameters:\n│                      #  z.object(), execute })\n├─ src/guardrails/     # block bad in/out\n└─ .env                # OPENAI_API_KEY",
