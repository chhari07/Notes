   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "1 Role     who the AI acts as\n2 Goal     what you want at the end\n3 Context  stack, folders, docs\n4 Steps    'plan first, show me, then code'\n5 Rules    what NOT to do, limits\n6 Done     how we know it's finished",
   "originalText": "1 Role     who the AI acts as\n2 Goal     what you want at the end\n3 Context  stack, folders, docs\n4 Steps    'plan first, show me, then code'\n5 Rules    what NOT to do, limits\n6 Done     how we know it's finished",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "n03149399",
