   "text": "my_agent/\n├─ .claude/agents|skills/\n├─ CLAUDE.md        # rules\n├─ src/my_agent/main.py\n│   # async for msg in query()\n├─ options.py  # ClaudeAgentOptions(\n│   #  allowed_tools, system_prompt)\n├─ tools.py    # @tool +\n│   #  create_sdk_mcp_server\n└─ .env        # ANTHROPIC_API_KEY",
