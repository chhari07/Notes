   "text": "my_agent/app/\n├─ main.py     # Runner.run(triage, in)\n├─ agents/triage.py\n│   # Agent(handoffs=[...])\n├─ agents/support.py\n├─ tools/orders.py\n│   # @function_tool get_order()\n├─ guardrails.py\n│   # @input_guardrail\n└─ .env        # OPENAI_API_KEY",
