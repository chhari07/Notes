  {
   "id": "n03155258",
   "type": "text",
   "x": 40,
   "y": 2720,
   "width": 448.59999999999997,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00315",
   "roundness": null,
   "seed": 27228034,
   "version": 1,
   "versionNonce": 454321911,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "You are a senior TypeScript developer.\nGoal: build a support agent with the Claude Agent SDK.\nContext: Node 20, src/index.ts, src/agent.ts, src/tools/.\nSteps: 1) plan + folder tree, wait for OK\n       2) write the code  3) add one test\nRules: only Read + Grep. No new libs without asking.\nDone when: `npm test` passes and it answers\n\"where is my order 123?\" using getOrder.",
   "originalText": "You are a senior TypeScript developer.\nGoal: build a support agent with the Claude Agent SDK.\nContext: Node 20, src/index.ts, src/agent.ts, src/tools/.\nSteps: 1) plan + folder tree, wait for OK\n       2) write the code  3) add one test\nRules: only Read + Grep. No new libs without asking.\nDone when: `npm test` passes and it answers\n\"where is my order 123?\" using getOrder.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "n03166729",
   "type": "text",
   "x": 40,
   "y": 2900,
   "width": 422.88000000000005,
   "height": 127.5,
   "angle": 0,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00316",
   "roundness": null,
   "seed": 934779977,
   "version": 1,
   "versionNonce": 160865917,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792511904971,
   "link": null,
   "locked": false,
   "text": "most used (no code)\n- plan-first: 'plan first, do not code yet'\n- few-shot: 1-2 examples of the output\n- chaining: big job -> small prompts\n- fix: paste error + 'find the cause first'\n- review: 'list only real bugs in this diff'",
   "originalText": "most used (no code)\n- plan-first: 'plan first, do not code yet'\n- few-shot: 1-2 examples of the output\n- chaining: big job -> small prompts\n- fix: paste error + 'find the cause first'\n- review: 'list only real bugs in this diff'",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "n03177040",
   "type": "text",
   "x": 680,
   "y": 2480,
