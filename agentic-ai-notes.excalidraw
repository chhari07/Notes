   "text": "my-product/\n├─ app/  (static export + Capacitor)\n│  ├─ lib/agentClient.ts\n│  ├─ lib/storage.ts  # offline\n│  └─ android/ ios/\n├─ api/  (Next.js on Vercel)\n│  ├─ app/api/agent/route.ts\n│  │    # auth -> runAgent()\n│  ├─ agents/quiz-agent.ts\n│  ├─ agents/tools/getHighlights.ts\n│  └─ .env   # model keys ONLY here\n└─ shared/types.ts",
   "originalText": "my-product/\n├─ app/  (static export + Capacitor)\n│  ├─ lib/agentClient.ts\n│  ├─ lib/storage.ts  # offline\n│  └─ android/ ios/\n├─ api/  (Next.js on Vercel)\n│  ├─ app/api/agent/route.ts\n│  │    # auth -> runAgent()\n│  ├─ agents/quiz-agent.ts\n│  ├─ agents/tools/getHighlights.ts\n│  └─ .env   # model keys ONLY here\n└─ shared/types.ts",
