   "link": null,
   "locked": false
  },
  {
   "id": "text-142",
   "type": "text",
   "x": 48,
   "y": 2198.75,
   "width": 505.44,
   "height": 202.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 612266532,
   "version": 1,
   "versionNonce": 173538603,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CHUNKING\n\nLong documents are split because one vector for a\nwhole document blurs its meaning, and prompts have\nlimited space. Chunks too large bring noise and cost;\ntoo small lose context. Overlap keeps ideas that cross\na boundary. Store metadata like source and shop with\neach chunk. A product record is often one chunk\nalready; chunking matters most for policies and FAQs.",
   "originalText": "CHUNKING\n\nLong documents are split because one vector for a\nwhole document blurs its meaning, and prompts have\nlimited space. Chunks too large bring noise and cost;\ntoo small lose context. Overlap keeps ideas that cross\na boundary. Store metadata like source and shop with\neach chunk. A product record is often one chunk\nalready; chunking matters most for policies and FAQs.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-141",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "rectangle-143",
   "type": "rectangle",
   "x": 608,
   "y": 2130,
   "width": 547,
   "height": 340,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1986134156,
   "version": 1,
   "versionNonce": 831348735,
   "isDeleted": false,
   "boundElements": [
