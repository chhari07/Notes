   "versionNonce": 1449594924,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Worked example\n\nA = [1, 2]    B = [2, 1]\n\nDot: (1×2) + (2×1) = 4\nLengths: √5 and √5\n\n4 / (√5 × √5) = 4 / 5 = 0.8",
   "originalText": "Worked example\n\nA = [1, 2]    B = [2, 1]\n\nDot: (1×2) + (2×1) = 4\nLengths: √5 and √5\n\n4 / (√5 × √5) = 4 / 5 = 0.8",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle-43",
   "lineHeight": 1.25,
   "autoResize": true
  },
