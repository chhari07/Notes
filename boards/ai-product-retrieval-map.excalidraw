  {
   "id": "text-44",
   "type": "text",
   "x": 826.62,
   "y": 535.0,
   "width": 266.76,
   "height": 190.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
