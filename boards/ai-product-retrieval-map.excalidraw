   "link": null,
   "locked": false
  },
  {
   "id": "text-140",
   "type": "text",
   "x": 1782,
   "y": 1817.5,
   "width": 505.44,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
