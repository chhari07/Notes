   "roundness": null,
   "seed": 1356702802,
   "version": 1,
   "versionNonce": 1969939069,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STREAMING AND RELIABILITY\n\nLLM calls can take seconds, so stream the words to\nkeep the screen alive. Set timeouts and retries, rate-\nlimit each user, and cache repeated queries to cut\ncost. Slow or expensive work belongs in background\njobs. Plan for the provider being down by falling back\nto plain search. Log latency, tokens and cost for\nevery request so problems are visible.",
   "originalText": "STREAMING AND RELIABILITY\n\nLLM calls can take seconds, so stream the words to\nkeep the screen alive. Set timeouts and retries, rate-\nlimit each user, and cache repeated queries to cut\ncost. Slow or expensive work belongs in background\njobs. Plan for the provider being down by falling back\nto plain search. Log latency, tokens and cost for\nevery request so problems are visible.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-153",
   "lineHeight": 1.25,
   "autoResize": true
  },
