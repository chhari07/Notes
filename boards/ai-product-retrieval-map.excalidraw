   "locked": false
  },
  {
   "id": "text-152",
   "type": "text",
   "x": 626,
   "y": 2568.75,
   "width": 505.44,
   "height": 202.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
