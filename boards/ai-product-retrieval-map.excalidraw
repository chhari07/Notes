   "versionNonce": 1630782869,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STRUCTURED OUTPUT\n\nApps need data, not paragraphs. Ask the model for JSON\nthat fits a schema, such as product, quantity and\nunit. Validate it with a library like Zod, then retry\nor fall back if it fails. Valid format does not mean\ncorrect content: \"aadha kilo aata\" should become 0.5\nkg of atta, and the product must still be checked\nagainst your real catalogue.",
   "originalText": "STRUCTURED OUTPUT\n\nApps need data, not paragraphs. Ask the model for JSON\nthat fits a schema, such as product, quantity and\nunit. Validate it with a library like Zod, then retry\nor fall back if it fails. Valid format does not mean\ncorrect content: \"aadha kilo aata\" should become 0.5\nkg of atta, and the product must still be checked\nagainst your real catalogue.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-151",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "rectangle-153",
   "type": "rectangle",
   "x": 1186,
   "y": 2500,
   "width": 547,
   "height": 340,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
