   "locked": false
  },
  {
   "id": "text-148",
   "type": "text",
   "x": 1782,
   "y": 2198.75,
   "width": 496.08000000000004,
   "height": 202.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
