   "roundness": null,
   "seed": 818700498,
   "version": 1,
   "versionNonce": 1860624808,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "EMBEDDINGS\n\nAn embedding model maps text to a fixed-length list of\nnumbers, placing similar meanings close together.\n\"Chai\" lands near \"Indian tea\" and far from \"laptop\".\nUse the same model for products and queries; changing\nit means re-embedding everything. Embeddings are weak\non exact details like pack size or SKU code, and may\nbe weaker on Hindi-English text, so test them on your\nown data.",
   "originalText": "EMBEDDINGS\n\nAn embedding model maps text to a fixed-length list of\nnumbers, placing similar meanings close together.\n\"Chai\" lands near \"Indian tea\" and far from \"laptop\".\nUse the same model for products and queries; changing\nit means re-embedding everything. Embeddings are weak\non exact details like pack size or SKU code, and may\nbe weaker on Hindi-English text, so test them on your\nown data.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-139",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "rectangle-141",
   "type": "rectangle",
   "x": 30,
   "y": 2130,
   "width": 547,
   "height": 340,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
