   "link": null,
   "locked": false
  },
  {
   "id": "text-146",
   "type": "text",
   "x": 1204,
   "y": 2187.5,
   "width": 505.44,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 501328028,
   "version": 1,
   "versionNonce": 1334762948,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "HYBRID SEARCH\n\nBM25 ranks by matching words and gives rare words more\nweight, so it suits brand names and exact terms. Fuzzy\nmatching handles typos using edit distance. Vectors\nhandle meaning. Each fails in different cases, so run\nthem together and merge the lists. A common method is\nReciprocal Rank Fusion, which combines by rank\nposition, because raw scores from different methods\nare not comparable.",
   "originalText": "HYBRID SEARCH\n\nBM25 ranks by matching words and gives rare words more\nweight, so it suits brand names and exact terms. Fuzzy\nmatching handles typos using edit distance. Vectors\nhandle meaning. Each fails in different cases, so run\nthem together and merge the lists. A common method is\nReciprocal Rank Fusion, which combines by rank\nposition, because raw scores from different methods\nare not comparable.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-145",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "rectangle-147",
   "type": "rectangle",
   "x": 1764,
   "y": 2130,
   "width": 547,
   "height": 340,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
