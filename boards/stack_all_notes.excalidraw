      "type": "text",
      "x": 6030,
      "y": 1670,
      "width": 634.4,
      "height": 250.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
