    {
      "id": "V4mmGyiljN6M6xtiKFNU",
      "type": "text",
      "x": 6940,
      "y": 545,
      "width": 644.8000000000001,
      "height": 375.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
