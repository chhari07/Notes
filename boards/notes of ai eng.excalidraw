    {
      "id": "2sTFaPX3rDbF19nsHuxNj",
      "type": "text",
      "x": 7182.2056811322545,
      "y": 4897.67410141293,
      "width": 548.8594970703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3F",
      "roundness": null,
      "seed": 531605792,
      "version": 3,
      "versionNonce": 360556832,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418288,
      "link": null,
      "locked": false,
      "created": 1793517407025,
      "text": "These are two fundamental concepts in LLM engineering.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "These are two fundamental concepts in LLM engineering.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DENJ23KP0lqEFRgmepJmc",
      "type": "text",
      "x": 7421.57547025579,
      "y": 4967.67410141293,
      "width": 70.11991882324219,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3G",
      "roundness": null,
      "seed": 861075680,
      "version": 3,
      "versionNonce": 1231354080,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418288,
      "link": null,
      "locked": false,
      "created": 1793517407025,
      "text": "Tokens",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Tokens",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uVdFLs-L_qM1syCJQ9kGn",
      "type": "text",
      "x": 7078.305809306083,
      "y": 5025.17410141293,
      "width": 756.6592407226562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 438142240,
      "version": 3,
      "versionNonce": 640386336,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418288,
      "link": null,
      "locked": false,
      "created": 1793517407026,
      "text": "An LLM doesn't directly process text as ordinary words. It processes tokens\ngenerated by a tokenizer.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "An LLM doesn't directly process text as ordinary words. It processes tokens generated by a tokenizer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ihIByXMGs0C5posakCtzd",
      "type": "text",
      "x": 7397.105476664481,
      "y": 5132.67410141293,
      "width": 119.05990600585938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 1145101536,
      "version": 3,
      "versionNonce": 1209195744,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418288,
      "link": null,
      "locked": false,
      "created": 1793517407026,
      "text": "For example:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "For example:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E164WtTGcdIgILwwLnhDN",
      "type": "text",
      "x": 7307.485588358817,
      "y": 5167.67410141293,
      "width": 298.2996826171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3J",
      "roundness": null,
      "seed": 1114628384,
      "version": 3,
      "versionNonce": 482205984,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418288,
      "link": null,
      "locked": false,
      "created": 1793517407026,
      "text": "\"Artificial intelligence is useful\"",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "\"Artificial intelligence is useful\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jiAhfIOqTxM1Un5_YIyRE",
      "type": "text",
      "x": 7066.175773905692,
