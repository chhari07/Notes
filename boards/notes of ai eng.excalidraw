      "seed": 409764285,
      "version": 6,
      "versionNonce": 1078497568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "6  Theory: the ideas behind each step",
      "originalText": "6  Theory: the ideas behind each step",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b17",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-133",
      "type": "rectangle",
      "x": 30,
      "y": 1760,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1468909588,
      "version": 2,
      "versionNonce": 1979493449,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-134"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b18"
    },
    {
      "id": "text-134",
      "type": "text",
      "x": 35,
      "y": 1817.5,
      "width": 482.6129150390625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1122348329,
      "version": 6,
      "versionNonce": 123301152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "WHAT IS AN LLM\n\nA neural network trained on huge amounts of text.\nGiven some text, it predicts the next token, again and\nagain, and that is how it writes. It has no live\ndatabase, so it does not know today's price or stock,\nand its knowledge stops at a training cutoff. It can\nsound confident while being wrong, which is called\nhallucination. Treat it as a writer and reasoner, not\na source of truth.",
      "originalText": "WHAT IS AN LLM\n\nA neural network trained on huge amounts of text.\nGiven some text, it predicts the next token, again and\nagain, and that is how it writes. It has no live\ndatabase, so it does not know today's price or stock,\nand its knowledge stops at a training cutoff. It can\nsound confident while being wrong, which is called\nhallucination. Treat it as a writer and reasoner, not\na source of truth.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-133",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b19",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-135",
      "type": "rectangle",
      "x": 608,
      "y": 1760,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 600369833,
      "version": 2,
      "versionNonce": 68303657,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-136"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1A"
    },
    {
      "id": "text-136",
      "type": "text",
      "x": 613,
      "y": 1828.75,
      "width": 476.708984375,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 460349300,
      "version": 6,
      "versionNonce": 1877920032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "TOKENS AND CONTEXT WINDOW\n\nText is split into tokens, small pieces of words.\nEverything in one call (system prompt, chat history,\nretrieved evidence and the answer) must fit in the\ncontext window. APIs usually charge per input and\noutput token, so more context costs more and can be\nslower. The model remembers nothing between calls:\nyour app resends whatever history it needs.",
      "originalText": "TOKENS AND CONTEXT WINDOW\n\nText is split into tokens, small pieces of words.\nEverything in one call (system prompt, chat history,\nretrieved evidence and the answer) must fit in the\ncontext window. APIs usually charge per input and\noutput token, so more context costs more and can be\nslower. The model remembers nothing between calls:\nyour app resends whatever history it needs.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-135",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1B",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-137",
      "type": "rectangle",
      "x": 1186,
      "y": 1760,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1015108052,
      "version": 2,
      "versionNonce": 441642505,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-138"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1C"
    },
    {
      "id": "text-138",
      "type": "text",
      "x": 1191,
      "y": 1828.75,
      "width": 471.470947265625,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 354580404,
      "version": 6,
      "versionNonce": 1433969952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "WHY RAG EXISTS\n\nThe model does not know your data, and retraining it\nfor every price change is impractical. RAG fetches\nrelevant facts at question time and puts them in the\nprompt. This gives fresher answers, fewer invented\nfacts, and answers that can point to a source. The\nlimit: if retrieval misses the right item, the answer\nfails too. So measure retrieval first, then the LLM.",
      "originalText": "WHY RAG EXISTS\n\nThe model does not know your data, and retraining it\nfor every price change is impractical. RAG fetches\nrelevant facts at question time and puts them in the\nprompt. This gives fresher answers, fewer invented\nfacts, and answers that can point to a source. The\nlimit: if retrieval misses the right item, the answer\nfails too. So measure retrieval first, then the LLM.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-137",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1D",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-139",
      "type": "rectangle",
      "x": 1764,
      "y": 1760,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 845716458,
      "version": 2,
      "versionNonce": 1337607401,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-140"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1E"
    },
    {
      "id": "text-140",
      "type": "text",
      "x": 1769,
      "y": 1817.5,
      "width": 486.9149169921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 818700498,
      "version": 6,
      "versionNonce": 627507488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "EMBEDDINGS\n\nAn embedding model maps text to a fixed-length list of\nnumbers, placing similar meanings close together.\n\"Chai\" lands near \"Indian tea\" and far from \"laptop\".\nUse the same model for products and queries; changing\nit means re-embedding everything. Embeddings are weak\non exact details like pack size or SKU code, and may\nbe weaker on Hindi-English text, so test them on your\nown data.",
      "originalText": "EMBEDDINGS\n\nAn embedding model maps text to a fixed-length list of\nnumbers, placing similar meanings close together.\n\"Chai\" lands near \"Indian tea\" and far from \"laptop\".\nUse the same model for products and queries; changing\nit means re-embedding everything. Embeddings are weak\non exact details like pack size or SKU code, and may\nbe weaker on Hindi-English text, so test them on your\nown data.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-139",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1F",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-141",
      "type": "rectangle",
      "x": 30,
      "y": 2130,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 263261459,
      "version": 2,
      "versionNonce": 1339277257,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-142"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1G"
    },
    {
      "id": "text-142",
      "type": "text",
      "x": 35,
      "y": 2198.75,
      "width": 483.296875,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 612266532,
      "version": 6,
      "versionNonce": 522837280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "CHUNKING\n\nLong documents are split because one vector for a\nwhole document blurs its meaning, and prompts have\nlimited space. Chunks too large bring noise and cost;\ntoo small lose context. Overlap keeps ideas that cross\na boundary. Store metadata like source and shop with\neach chunk. A product record is often one chunk\nalready; chunking matters most for policies and FAQs.",
      "originalText": "CHUNKING\n\nLong documents are split because one vector for a\nwhole document blurs its meaning, and prompts have\nlimited space. Chunks too large bring noise and cost;\ntoo small lose context. Overlap keeps ideas that cross\na boundary. Store metadata like source and shop with\neach chunk. A product record is often one chunk\nalready; chunking matters most for policies and FAQs.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-141",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1H",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-143",
      "type": "rectangle",
      "x": 608,
      "y": 2130,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1986134156,
      "version": 2,
      "versionNonce": 1220206249,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-144"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1I"
    },
    {
      "id": "text-144",
      "type": "text",
      "x": 613,
      "y": 2198.75,
      "width": 491.32489013671875,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1325613799,
      "version": 6,
      "versionNonce": 338770208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "VECTOR SEARCH\n\nComparing a query with every vector is exact but slow\nat scale. Approximate Nearest Neighbour indexes such\nas HNSW and IVFFlat (both in pgvector) give up a\nlittle accuracy for much more speed and return the\ntop-k matches. Metadata filters narrow results by shop\nor category. Postgres with pgvector is a good start,\nas vectors and product data live in one database.",
      "originalText": "VECTOR SEARCH\n\nComparing a query with every vector is exact but slow\nat scale. Approximate Nearest Neighbour indexes such\nas HNSW and IVFFlat (both in pgvector) give up a\nlittle accuracy for much more speed and return the\ntop-k matches. Metadata filters narrow results by shop\nor category. Postgres with pgvector is a good start,\nas vectors and product data live in one database.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-143",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1J",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-145",
      "type": "rectangle",
      "x": 1186,
      "y": 2130,
      "width": 547,
      "height": 340,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 517958389,
      "version": 2,
      "versionNonce": 421208457,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-146"
        }
      ],
      "updated": 1793462357368,
      "link": null,
      "locked": false,
      "index": "b1K"
    },
    {
      "id": "text-146",
      "type": "text",
      "x": 1191,
      "y": 2187.5,
      "width": 506.768798828125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 501328028,
      "version": 6,
      "versionNonce": 669848864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932510,
      "link": null,
      "locked": false,
      "text": "HYBRID SEARCH\n\nBM25 ranks by matching words and gives rare words more\nweight, so it suits brand names and exact terms. Fuzzy\nmatching handles typos using edit distance. Vectors\nhandle meaning. Each fails in different cases, so run\nthem together and merge the lists. A common method is\nReciprocal Rank Fusion, which combines by rank\nposition, because raw scores from different methods\nare not comparable.",
      "originalText": "HYBRID SEARCH\n\nBM25 ranks by matching words and gives rare words more\nweight, so it suits brand names and exact terms. Fuzzy\nmatching handles typos using edit distance. Vectors\nhandle meaning. Each fails in different cases, so run\nthem together and merge the lists. A common method is\nReciprocal Rank Fusion, which combines by rank\nposition, because raw scores from different methods\nare not comparable.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-145",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1L",
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "rectangle-147",
      "type": "rectangle",
      "x": 1764,
      "y": 2130,
      "width": 547,
