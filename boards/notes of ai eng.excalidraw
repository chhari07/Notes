      "seed": 425254209,
      "version": 6,
      "versionNonce": 290207008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793504932509,
      "link": null,
      "locked": false,
      "text": "If the LLM or search fails, the backend falls back to plain catalogue search, so the app still works.",
      "originalText": "If the LLM or search fails, the backend falls back to plain catalogue search, so the app still works.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b15",
