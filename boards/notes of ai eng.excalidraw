    },
    {
      "id": "CjPCqmlzTr-tbuiiUTNap",
      "type": "text",
      "x": 7066.125725077567,
      "y": 7700.17410141293,
      "width": 781.0194091796875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b46",
      "roundness": null,
      "seed": 227385568,
      "version": 3,
      "versionNonce": 824156384,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418289,
      "link": null,
      "locked": false,
      "created": 1793517407031,
      "text": "RAG is useful when the answer needs to be grounded in information that is not\nreliably available in the model's learned knowledge.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "RAG is useful when the answer needs to be grounded in information that is not reliably available in the model's learned knowledge.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tzFzWZ7A6suX4QyjxS6VZ",
      "type": "text",
      "x": 7067.005790995536,
      "y": 7795.17410141293,
      "width": 779.25927734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b47",
      "roundness": null,
      "seed": 339828000,
      "version": 3,
      "versionNonce": 718232864,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793517418289,
      "link": null,
      "locked": false,
      "created": 1793517407031,
      "text": "It doesn't retrain the LLM. It gives the model relevant information at inference\ntime.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "It doesn't retrain the LLM. It gives the model relevant information at inference time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
