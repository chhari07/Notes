      "link": null,
      "locked": false,
      "created": 1793538789254,
      "text": "Imagine your application\nhas a conversation with\n100 messages. Sending the\nentire conversation to the\nLLM every time may be\nexpensive and exceed the\ncontext limit.",
      "fontSize": 70.33458116319444,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Imagine your application has a conversation with 100 messages. Sending the entire conversation to the LLM every time may be expensive and exceed the context limit.",
