      "locked": false,
      "created": 1793517729980,
      "text": "might be divided into several\ntokens. A token can be a\ncomplete word, part of a word,\npunctuation, or another text\nunit.",
      "fontSize": 40.12711471316783,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "might be divided into several tokens. A token can be a complete word, part of a word, punctuation, or another text unit.",
