      "boundElements": null,
      "updated": 1793517007849,
      "link": null,
      "locked": false,
      "created": 1793516979719,
      "text": "The LLM is the language and reasoning engine, not your entire application.",
      "fontSize": 57.18675014331883,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "The LLM is the language and reasoning engine, not your entire application.",
