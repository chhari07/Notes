      "created": 1793544632411,
      "text": "A user asks:",
      "fontSize": 102.08480490841626,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "A user asks:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WFusqGLnfFAVFpamCRktp",
      "type": "text",
      "x": 15318.739821574713,
      "y": 5725.251976460532,
      "width": 1724.2352488718532,
      "height": 88.2124910882069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5E",
      "roundness": null,
      "seed": 447012064,
      "version": 384,
      "versionNonce": 1129808160,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632411,
      "text": "Is the OnePlus 13 available, and what is its price?",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Is the OnePlus 13 available, and what is its price?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FQUfoyk6HOeUqYzn8Fcmk",
      "type": "text",
      "x": 14333.90393013507,
      "y": 5912.317516152185,
      "width": 2446.659154617193,
      "height": 176.4249821764138,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5F",
      "roundness": null,
      "seed": 1951129888,
      "version": 400,
      "versionNonce": 722099488,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632411,
      "text": "Your LLM has general knowledge about OnePlus phones, but it doesn't\nautomatically know what's inside your application's MongoDB database.",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Your LLM has general knowledge about OnePlus phones, but it doesn't automatically know what's inside your application's MongoDB database.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "CztDHZs7XovtEIwt-kWHm",
      "type": "text",
      "x": 17687.343918001505,
      "y": 5437.966950170552,
      "width": 1321.4924632350564,
      "height": 88.2124910882069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 800473312,
      "version": 397,
      "versionNonce": 1342290208,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632411,
      "text": "Without RAG or database integration:",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Without RAG or database integration:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2slN1-pqf--7ieW3RwjfE",
      "type": "text",
      "x": 17704.852809046683,
      "y": 5796.837639491538,
      "width": 1388.3927863255988,
      "height": 88.2124910882069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5H",
      "roundness": null,
      "seed": 2121448736,
      "version": 402,
      "versionNonce": 363697440,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632411,
      "text": "- The LLM might give an outdated price.",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "- The LLM might give an outdated price.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y9y1TLou_PeAWngxhereh",
      "type": "text",
      "x": 17654.033247558404,
      "y": 6083.900265031449,
      "width": 1725.6465195117485,
      "height": 88.2124910882069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 1694180576,
      "version": 414,
      "versionNonce": 1904079136,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632411,
      "text": "- It might incorrectly say the product is available.",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "- It might incorrectly say the product is available.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OKSSAB0d0fHGLITqNPtTe",
      "type": "text",
      "x": 17671.085449241047,
      "y": 6465.7930184526085,
      "width": 1832.348098911512,
      "height": 88.2124910882069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
