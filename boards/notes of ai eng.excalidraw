      "link": null,
      "locked": false,
      "created": 1793517407027,
      "text": "The context window is the maximum amount of tokenized information a model can\nprocess in one request, including the relevant input, instructions, conversation\nhistory, retrieved content, and generated output, subject to the model's specific\nrules.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "The context window is the maximum amount of tokenized information a model can process in one request, including the relevant input, instructions, conversation history, retrieved content, and generated output, subject to the model's specific rules.",
      "autoResize": false,
      "lineHeight": 1.25
    },
