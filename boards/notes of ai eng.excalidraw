    {
      "id": "text-130",
      "type": "text",
      "x": 30,
      "y": 1590,
      "width": 874.7403564453125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
