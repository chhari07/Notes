    {
      "id": "text-132",
      "type": "text",
      "x": 30,
      "y": 1710,
      "width": 525.1980590820312,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
