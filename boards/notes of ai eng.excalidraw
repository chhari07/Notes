      "boundElements": null,
      "updated": 1793545205680,
      "link": null,
      "locked": false,
      "created": 1793544632412,
      "text": "- It might generate an answer based on assumptions.",
      "fontSize": 70.56999287056554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "- It might generate an answer based on assumptions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
