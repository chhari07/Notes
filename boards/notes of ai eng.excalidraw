    {
      "id": "oOsGPzIMGXdjppA8D_vL5",
      "type": "text",
      "x": 1604.9327444093717,
      "y": 6386.450252999024,
      "width": 2326.2004988245308,
      "height": 155.62798612114153,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
