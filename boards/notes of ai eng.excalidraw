      "boundElements": null,
      "updated": 1793516757964,
      "link": null,
      "locked": false,
      "created": 1793510884675,
      "text": "The LLM processes the input and generates a response based on its learned\nparameters and the context supplied to it.",
      "fontSize": 62.25119444845661,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "The LLM processes the input and generates a response based on its learned parameters and the context supplied to it.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eD1oDz2-1JGwsujFotOdw",
      "type": "text",
      "x": 1650.700302182375,
      "y": 6695.072102134885,
      "width": 836.0169523025766,
      "height": 72.28486134154103,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b38",
      "roundness": null,
      "seed": 610632928,
      "version": 217,
      "versionNonce": 1615363296,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793516765608,
      "link": null,
      "locked": false,
      "created": 1793510898830,
      "text": "From a full-stack perspective:",
      "fontSize": 57.827889073232825,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "From a full-stack perspective:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JM__XWTcDGKAVThvqly1f",
      "type": "text",
      "x": 1642.31726994367,
      "y": 6895.818641395165,
      "width": 2182.0754273916145,
      "height": 144.56972268308206,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b39",
      "roundness": null,
      "seed": 1648998688,
      "version": 183,
      "versionNonce": 5964064,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793517058733,
      "link": null,
      "locked": false,
      "created": 1793510898830,
      "text": "You generally don't train the LLM yourself. You integrate it into your backend\nthrough an API or deploy an open-weight model.",
      "fontSize": 57.82788907323281,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "You generally don't train the LLM yourself. You integrate it into your backend through an API or deploy an open-weight model.",
      "autoResize": false,
      "lineHeight": 1.25
    },
