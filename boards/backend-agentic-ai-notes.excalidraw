   "locked": false
  },
  {
   "id": "tex16_3961",
   "type": "text",
   "x": 367.0,
   "y": 768.0,
   "width": 1426.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 221310450,
   "version": 1,
   "versionNonce": 1248976841,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762600000000,
   "link": null,
   "locked": false,
   "text": "SHORT VERSION:  Backend development is the server side of an app: APIs, databases, login and deployment. Agentic AI\nis AI that works in a loop of plan, act and check to finish a goal using tools. In 2026 the two have merged. The\nbackend is where agents get their tools, memory and safety rules. These notes explain both, and how to build them\ntogether.",
   "originalText": "SHORT VERSION:  Backend development is the server side of an app: APIs, databases, login and deployment. Agentic AI\nis AI that works in a loop of plan, act and check to finish a goal using tools. In 2026 the two have merged. The\nbackend is where agents get their tools, memory and safety rules. These notes explain both, and how to build them\ntogether.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec15_6054",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 18
  },
  {
